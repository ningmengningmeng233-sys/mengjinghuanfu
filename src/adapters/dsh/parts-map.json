{
  "app.root": {
    "scope": "html",
    "scopeBody": "body",
    "selector": "body #root",
    "required": true
  },
  "app.sidebar": {
    "selector": "[data-slot=\"sidebar\"], [data-sidebar-right-panel]",
    "pane": "[data-slot=\"sidebar\"], [data-sidebar-right-panel]",
    "required": true
  },
  "app.sidebar.item": {
    "selector": "[data-row-key^=\"session:\"]"
  },
  "app.sidebar.item.active": {
    "selector": "[data-row-key^=\"session:\"][aria-selected=\"true\"], [data-row-key^=\"session:\"][data-selected=\"true\"], [data-row-key^=\"session:\"][data-active=\"true\"]"
  },
  "app.topbar": {
    "selector": "[data-slot=\"conversation.header\"]"
  },
  "app.content": {
    "selector": "[data-slot=\"main\"]",
    "required": true
  },
  "chat.messages": {
    "selector": "[data-conversation-scroll]",
    "list": "[data-slot=\"conversation.chat.flow\"]",
    "shell": "[data-slot=\"conversation.view\"]"
  },
  "chat.bubble.user": {
    "selector": "[data-chat-flow-kind=\"user\"] > div, [data-chat-flow-kind=\"user\"] [data-message-bubble]"
  },
  "chat.bubble.assistant": {
    "selector": "[data-chat-group-part=\"response\"]"
  },
  "chat.composer": {
    "selector": "[data-composer-card]",
    "dock": "[data-slot=\"conversation.composer\"]",
    "radius": "[data-composer-card]",
    "required": true
  },
  "chat.composer.input": {
    "selector": "[data-composer-input]"
  },
  "code.block": {
    "selector": ".md-code-block, pre"
  },
  "overlay.panel": {
    "selector": "[role=\"dialog\"], [role=\"menu\"], [data-radix-popper-content-wrapper] > *, [data-sidebar-drawer], [data-conversation-composer-overlay], [data-plugin-detail]"
  }
}
