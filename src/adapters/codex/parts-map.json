{
  "app.root": {
    "scope": "html:has(#app-shell-sidebar)",
    "scopeBody": "body:has(#app-shell-sidebar)",
    "selector": "body:has(#app-shell-sidebar) #root",
    "required": true
  },
  "app.sidebar": {
    "selector": "#app-shell-sidebar",
    "pane": "#app-shell-sidebar",
    "required": true
  },
  "app.sidebar.item": {
    "selector": "[data-app-action-sidebar-thread-row], [data-app-action-sidebar-project-row]"
  },
  "app.topbar": {
    "selector": "header:has([data-test-id=\"header-shell-slot\"]), [data-app-shell-tab-row], header"
  },
  "app.content": {
    "selector": "[data-app-shell-focus-area=\"main\"], main[class*=\"_MainContentSurface_\"], main",
    "required": true
  },
  "chat.messages": {
    "selector": "[data-app-shell-focus-area=\"main\"] [role=\"log\"], main[class*=\"_MainContentSurface_\"] [role=\"log\"], main [data-scroll-container], [data-conversation-id]"
  },
  "chat.composer": {
    "selector": "[data-composer-surface-variant], [data-composer-layout], [class*=\"_ComposerLayoutRoot_\"]",
    "required": true
  },
  "chat.composer.input": {
    "selector": "[data-composer-input]"
  },
  "code.block": {
    "selector": "[data-composer-code-block], pre:has(> code)"
  },
  "overlay.panel": {
    "selector": "[role=\"dialog\"], [role=\"menu\"], [data-radix-popper-content-wrapper] > *"
  }
}
