{
  "schema": "dreamskin-adapter/1",
  "id": "minimax-design",
  "name": "MiniMax Design",
  "channel": "exe",
  "discover": {
    "candidates": [
      "%LOCALAPPDATA%\\Programs\\MiniMax Design\\MiniMax Design.exe"
    ],
    "envExe": "DREAMSKIN_MINIMAX_DESIGN_EXE",
    "exeNames": [
      "MiniMax Design.exe"
    ],
    "mac": {
      "bundle": "MiniMax Design",
      "source": "包名按产品名推断：MiniMax 官方产品线列有 macOS 桌面版（macOS 13 起），包名与包内可执行名未在真机核对",
      "status": "unverified"
    },
    "uninstallDisplayName": "MiniMax Design"
  },
  "target": {
    "uaToken": "MiniMaxDesign",
    "urlPattern": "^app://.*/workspace"
  },
  "readySelector": "aside.transparent-window-home-sidebar",
  "testedVersions": [
    "3.0.13"
  ],
  "partsMap": "parts-map.json",
  "extraCss": "extra.css"
}
