{
  "app.root": {
    "scope": "html:has(aside.transparent-window-home-sidebar)",
    "scopeBody": "body:has(aside.transparent-window-home-sidebar)",
    "selector": "body:has(aside.transparent-window-home-sidebar) #root",
    "required": true
  },
  "app.sidebar": {
    "selector": "aside.transparent-window-home-sidebar",
    "pane": "aside.transparent-window-home-sidebar",
    "required": true
  },
  "app.sidebar.item": {
    "selector": "button.home-sidebar-nav-pill"
  },
  "app.topbar": {
    "selector": "header.transparent-window-topbar"
  },
  "app.content": {
    "selector": "[data-workspace-stage-frame]",
    "required": true
  },
  "chat.messages": {
    "selector": "[data-testid=\"message-turn-virtualizer\"]"
  },
  "chat.bubble.assistant": {
    "selector": "[data-testid=\"chat-message-assistant-content\"]"
  },
  "chat.composer": {
    "selector": "[class*=\"group/composer\"]",
    "required": true
  },
  "chat.composer.input": {
    "selector": ".ProseMirror"
  }
}
