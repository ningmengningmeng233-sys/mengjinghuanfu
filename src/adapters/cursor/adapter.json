{
  "channel": "exe",
  "discover": {
    "candidates": [
      "%LOCALAPPDATA%\\Programs\\cursor\\Cursor.exe"
    ],
    "envExe": "DREAMSKIN_CURSOR_EXE",
    "exeNames": [
      "Cursor.exe"
    ],
    "uninstallDisplayName": "Cursor"
  },
  "extraCss": "extra.css",
  "id": "cursor",
  "name": "Cursor",
  "partsMap": "parts-map.json",
  "process": {
    "gracefulCloseMs": 8000
  },
  "readySelector": ".monaco-workbench",
  "restartNote": "未保存的文件会保留在编辑器中，重启会中断正在运行的任务",
  "schema": "dreamskin-adapter/1",
  "target": {
    "uaToken": "Cursor",
    "urlPattern": "^vscode-file://.*/workbench/workbench\\.html"
  },
  "testedVersions": [
    "3.27.22"
  ]
}
