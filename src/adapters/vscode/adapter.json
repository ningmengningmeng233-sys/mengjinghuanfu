{
  "schema": "dreamskin-adapter/1",
  "id": "vscode",
  "name": "VS Code",
  "channel": "exe",
  "discover": {
    "candidates": [
      "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe",
      "%ProgramFiles%\\Microsoft VS Code\\Code.exe"
    ],
    "envExe": "DREAMSKIN_VSCODE_EXE",
    "exeNames": [
      "Code.exe"
    ],
    "uninstallDisplayName": "Microsoft Visual Studio Code",
    "mac": {
      "bundle": "Visual Studio Code",
      "source": "官方 macOS 包名 /Applications/Visual Studio Code.app，尚未在真 Mac 核实",
      "status": "unverified"
    }
  },
  "prism": {
    "defaultDebugPort": 9353,
    "browserHoleSupport": false
  },
  "process": {
    "gracefulCloseMs": 8000
  },
  "target": {
    "urlPattern": "^(?:vscode-file|file)://.*/workbench/workbench\\.html"
  },
  "readySelector": ".monaco-workbench",
  "testedVersions": [
    "1.147.0"
  ],
  "partsMap": "parts-map.json",
  "extraCss": "extra.css"
}
