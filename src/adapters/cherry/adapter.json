{
  "channel": "exe",
  "discover": {
    "candidates": [
      "%LOCALAPPDATA%\\Programs\\Cherry Studio\\Cherry Studio.exe",
      "%ProgramFiles%\\Cherry Studio\\Cherry Studio.exe",
      "%ProgramFiles(x86)%\\Cherry Studio\\Cherry Studio.exe"
    ],
    "envExe": "DREAMSKIN_CHERRY_EXE",
    "exeNames": [
      "Cherry Studio.exe"
    ],
    "mac": {
      "bundle": "Cherry Studio",
      "source": "2.1 既有 discover.macBundle 沿用；官方提供 macOS 版（官网与 GitHub Releases 的 dmg、拖入 Applications），包名与包内可执行名未在真机核对",
      "status": "unverified"
    },
    "macBundle": "Cherry Studio",
    "uninstallDisplayName": "Cherry Studio"
  },
  "extraCss": "extra.css",
  "id": "cherry",
  "name": "Cherry Studio",
  "partsMap": "parts-map.json",
  "probes": [
    [
      "[data-ui=\"app.sidebar\"]",
      "侧边栏",
      "[data-ui=\"chat.view\"]"
    ],
    [
      "[data-ui=\"app.tab-bar\"]",
      "标签栏"
    ],
    [
      "[data-ui=\"app.content\"]",
      "内容区"
    ],
    [
      "[data-ui=\"chat.message-list\"]",
      "消息列表",
      "[data-ui=\"chat.view\"]"
    ],
    [
      "#inputbar",
      "输入框",
      "[data-ui=\"chat.view\"]"
    ]
  ],
  "process": {
    "gracefulCloseMs": 8000
  },
  "readySelector": "[data-ui=\"app.main\"]",
  "restartNote": "聊天记录不受影响，未发送的输入框内容会丢失",
  "schema": "dreamskin-adapter/1",
  "target": {
    "uaToken": "CherryStudio",
    "urlPattern": "^file://.*/windows/main/index\\.html"
  },
  "testedVersions": [
    "2.1.4",
    "2.1.6"
  ],
  "userCssId": "user-defined-custom-css"
}
