{
  "app.root": {
    "scope": "html:has(#root)",
    "scopeBody": "body",
    "selector": "#root",
    "required": true
  },
  "app.sidebar": {
    "selector": "[data-slot=\"sidebar-wrapper\"], aside, [class*=\"sidebar\"]"
  },
  "app.sidebar.item": {
    "selector": "[data-thread-item], [data-sidebar-row], aside a, aside [role=\"button\"]"
  },
  "app.topbar": {
    "selector": "header"
  },
  "app.content": {
    "selector": "[data-slot=\"sidebar-inset\"], main"
  },
  "chat.messages": {
    "selector": "[data-slot=\"sidebar-inset\"] [role=\"log\"], main [role=\"log\"], main [class*=\"message\"]"
  },
  "chat.composer": {
    "selector": "[data-chat-composer-surface=\"true\"], [data-composer-prompt-surface=\"true\"], [data-workspace-area=\"composer\"], form:has(textarea)"
  },
  "chat.composer.input": {
    "selector": "[data-testid=\"composer-editor\"]"
  },
  "code.block": {
    "selector": "pre:has(> code)"
  },
  "overlay.panel": {
    "selector": "[role=\"dialog\"], [role=\"menu\"]"
  }
}
